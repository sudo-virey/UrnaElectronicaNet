<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Urna Electrónica</title>
    <link rel="icon" type="image/png" href="~/images/icon.png">
    <link href="~/css/style.css" rel="stylesheet" />
    <script src="https://unpkg.com/htmx.org"></script>
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <span class="logo-icon">🗳️</span>
                    <div>
                        <h2>Urna Admin</h2>
                        <p>Gestión Electoral</p>
                    </div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/Home" 
                           hx-get="/Home" 
                           hx-target="#content-area"
                           hx-swap="innerHTML"
                           class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                            <span class="nav-icon">📊</span>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/ProcesoElectoral" 
                           hx-get="/ProcesoElectoral" 
                           hx-target="#content-area"
                           hx-swap="innerHTML"
                           class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ProcesoElectoral" ? "active" : "")">
                            <span class="nav-icon">🗳️</span>
                            <span class="nav-label">Procesos Electorales</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Urna" 
                           hx-get="/Urna" 
                           hx-target="#content-area"
                           hx-swap="innerHTML"
                           class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Urna" ? "active" : "")">
                            <span class="nav-icon">📦</span>
                            <span class="nav-label">Urnas</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Impresora" 
                           hx-get="/Impresora" 
                           hx-target="#content-area"
                           hx-swap="innerHTML"
                           class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Impresora" ? "active" : "")">
                            <span class="nav-icon">🖨️</span>
                            <span class="nav-label">Impresoras</span>
                        </a>
                    </li>
                    <li>
                        <a href="/EntidadPolitica" 
                           hx-get="/EntidadPolitica" 
                           hx-target="#content-area"
                           hx-swap="innerHTML"
                           class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "EntidadPolitica" ? "active" : "")">
                            <span class="nav-icon">🏛️</span>
                            <span class="nav-label">Entidades Políticas</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Reportes" 
                           hx-get="/Reportes" 
                           hx-target="#content-area"
                           hx-swap="innerHTML"
                           class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" ? "active" : "")">
                            <span class="nav-icon">📈</span>
                            <span class="nav-label">Reportes</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                @if (Context.Session.GetString("UsuarioEmail") != null)
                {
                    <div class="user-card">
                        <div class="user-avatar">👤</div>
                        <div class="user-details">
                            <p class="user-name">@Context.Session.GetString("UsuarioNombre")</p>
                            <p class="user-email">@Context.Session.GetString("UsuarioEmail")</p>
                        </div>
                    </div>
                    <a href="/Auth/Logout" class="logout-btn">
                        <span>🚪</span> Cerrar Sesión
                    </a>
                }
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">
                    <h1 class="page-title">Urna - Administración de Elecciones</h1>
                </div>
                <div class="header-right">
                    <div class="header-icons">
                        <button class="icon-btn">🔔</button>
                        <button class="icon-btn">⚙️</button>
                    </div>
                    @if (Context.Session.GetString("UsuarioNombre") != null)
                    {
                        <span class="welcome-text">Bienvenido, @Context.Session.GetString("UsuarioNombre")</span>
                    }
                </div>
            </header>

            <!-- Content Area (se carga dinámicamente) -->
            <main class="content-area" id="content-area">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                <p>&copy; 2026 IEAM - Instituto Electoral de Administración. Todos los derechos reservados.</p>
                <div class="footer-links">
                    <a href="#">Soporte Técnico</a>
                    <a href="#">Guía de Usuario</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/js/main.js"></script>
</body>
</html>
