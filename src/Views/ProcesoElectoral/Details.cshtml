@model UrnaElectronica.Models.ProcesoElectoral
@using UrnaElectronica.Controllers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Detalles del Proceso";
    // Definimos si el proceso está cerrado para usarlo en varios puntos
    bool esProcesoCerrado = Model.IdEstatus == 3;
    var candidatosPorEleccion = ViewBag.CandidatosPorEleccion as Dictionary<int, int> ?? new Dictionary<int, int>();
    var urnasPorEleccion = ViewBag.UrnasPorEleccion as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid py-4">
    <div style="margin-bottom: 1.5rem;">
        <a href="@Url.Action("Index")" class="btn-secondary-outline" style="text-decoration:none;">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-12 col-md-8">
                    <h1 class="h3 mb-1 fw-bold">@Model.Nombre</h1>
                    <p class="text-muted mb-2 mb-md-0">
                        <i class="far fa-calendar-alt me-1"></i>
                        Fecha del Evento: <strong>@(Model.FechaEvento?.ToString("dd/MM/yyyy") ?? "No asignada")</strong>
                    </p>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <span class="badge @(Model.IdEstatus == 1 ? "bg-success" : "bg-secondary") p-2 mb-2 shadow-sm"
                          style="font-size: 0.9rem;">
                        <i class="fas @(esProcesoCerrado ? "fa-archive" : "fa-check-circle") me-1"></i>
                        @ProcesoElectoralController.ObtenerEstatusTexto(Model.IdEstatus)
                    </span>
                    <div class="text-muted small">Creado: @Model.FechaCreacion.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold">Elecciones</h5>
                <small class="text-muted">Total de elecciones: @Model.Elecciones.Count(e => !e.Eliminado)</small>
            </div>


            @if (!esProcesoCerrado)
            {
                <button hx-get="/Eleccion/Create?procesoId=@Model.Id" hx-target="#modal-container"
                        class="btn-primary-action" style="border:none; cursor:pointer;">
                    <i class="fas fa-plus"></i> Registrar elección
                </button>
            }
            else
            {
                <span class="text-muted small"><i class="fas fa-ban me-1"></i> Bloqueado</span>
            }
        </div>

        <div class="card-body p-0">
            @if (!Model.Elecciones.Any(e => !e.Eliminado))
            {
                <div class="text-center py-5">
                    <i class="fas fa-layer-group fa-3x text-light mb-3 d-block"></i>
                    <p class="text-muted">No hay elecciones activas en este proceso.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var eleccion in Model.Elecciones.Where(e => !e.Eliminado))
                    {
                        <div class="list-group-item p-3 list-group-item-action">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="mb-2 fw-bold">@eleccion.Nombre</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-light text-dark border small fw-normal">
                                            <i class="fas fa-tablet-alt me-1 text-info"></i> @(urnasPorEleccion.ContainsKey(eleccion.Id) ? urnasPorEleccion[eleccion.Id] : 0) Urnas
                                        </span>
                                        <span class="badge bg-light text-dark border small fw-normal">
                                            <i class="fas fa-users me-1 text-primary"></i> @(candidatosPorEleccion.ContainsKey(eleccion.Id) ? candidatosPorEleccion[eleccion.Id] : 0) Candidatos
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex gap-2 align-items-center">
                                    @* Botones de acceso rápido siempre visibles *@
                                    <button hx-get="/UrnaEleccion/Listar/@eleccion.Id"
                                            hx-target="#urnas-area-@eleccion.Id"
                                            hx-swap="innerHTML"
                                            class="btn btn-sm btn-outline-info"
                                            title="Gestionar Urnas">
                                        <i class="fas fa-tablet-alt"></i>
                                    </button>
                                   
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary js-toggle-candidatos"
                                            data-eleccion-id="@eleccion.Id"
                                            data-expanded="false"
                                            title="Ver candidatos"
                                            aria-label="Ver candidatos">
                                        <i class="fas fa-users"></i>
                                    </button>
                                    @if (!esProcesoCerrado)
                                    {
                                        @* NUEVO: Botón Editar *@
                                        <button hx-get="/Eleccion/Edit/@eleccion.Id"      hx-target="#modal-container"  class="btn-icon"
                                                title="Editar Elección"             style="background:none; border:none; cursor:pointer;">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        @* Icono de eliminar con HTMX *@
                                        <button hx-post="/Eleccion/Delete/@eleccion.Id"
                                                hx-confirm="¿Estás seguro de que deseas eliminar la elección '@eleccion.Nombre'?"
                                                hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'
                                                class="btn btn-sm btn-outline-danger" title="Eliminar Elección"
                                                style="color: #dc3545; margin-left: 10px; background:none; border:none; cursor:pointer;">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <i class="fas fa-lock text-muted ms-2" title="Proceso Cerrado"></i>
                                    }
                                </div>
                                
                            </div>
                            <div id="urnas-area-@eleccion.Id" class="mt-3"></div>
                            <div id="candidatos-area-@eleccion.Id" class="mt-3"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div id="modal-container"></div>

<style>
    /* Ajustes para mejorar la experiencia móvil */
    .btn-sm {
        padding: 0.4rem 0.6rem;
    }

    .list-group-item:hover {
        background-color: #f8f9fa;
    }

    /* Evitar que el dropdown se corte en móviles */
    .dropdown-menu {
        z-index: 1050;
    }
</style>