@model UrnaElectronica.Models.ProcesoElectoral
@using UrnaElectronica.Controllers

@{
    ViewData["Title"] = "Detalles del Proceso";
}

<div class="container-fluid py-4">
    <div class="mb-3">
        <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Volver al listado
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-12 col-md-8">
                    <h1 class="h3 mb-1">@Model.Nombre</h1>
                    <p class="text-muted mb-2 mb-md-0">
                        <i class="far fa-calendar-alt me-1"></i> 
                        Fecha del Evento: <strong>@(Model.FechaEvento?.ToString("dd/MM/yyyy") ?? "No asignada")</strong>
                    </p>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <span class="badge @(Model.IdEstatus == 1 ? "bg-success" : "bg-secondary") p-2 mb-2">
                        @ProcesoElectoralController.ObtenerEstatusTexto(Model.IdEstatus)
                    </span>
                    <div class="text-muted small">Creado el @Model.FechaCreacion.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Elecciones Configuradas</h5>
            <button hx-get="/Eleccion/Create?procesoId=@Model.Id" 
                    hx-target="#modal-container" 
                    class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> <span class="d-none d-md-inline">Nueva Elección</span>
            </button>
        </div>
        <div class="card-body p-0">
            @if (!Model.Elecciones.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    <p class="text-muted">Aún no hay elecciones registradas en este proceso.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var eleccion in Model.Elecciones)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1 fw-bold text-primary">@eleccion.Nombre</h6>
                                    <p class="mb-2 small text-muted">ID Elección: #@eleccion.Id</p>
                                    
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <span class="badge bg-light text-dark border">
                                            <i class="fas fa-microchip me-1"></i> 0 Urnas asignadas
                                        </span>
                                    </div>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                        <li><a class="dropdown-item" href="#"><i class="fas fa-edit me-2 text-warning"></i> Editar</a></li>
                                        <li><a class="dropdown-item" href="#"><i class="fas fa-tablet-alt me-2 text-info"></i> Gestionar Urnas</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-trash me-2"></i> Eliminar</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div id="modal-container"></div>