@model UrnaElectronica.Models.ProcesoElectoral
@{ Layout = null; }

<div id="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 9999;">
    <div style="background: white; padding: 2rem; border-radius: 12px; width: 500px; max-width: 95%; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
        <h3 style="margin-top: 0; color: #333;">
            Crear Proceso
        </h3>
        @* CAMBIO CLAVE: hx-target debe ser el contenedor de tu DASHBOARD, no el body *@
        <form hx-post="/ProcesoElectoral/Create"  hx-target="#modal-container">
            @Html.AntiForgeryToken()
                <div style="margin-bottom: 1rem;">
                   <label style="display: block; font-weight: 600;">Nombre:</label>
                    <input type="text" name="Nombre" class="form-control" required maxlength="100">
                </div>
               <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600;">Fecha de Cierre (Evento):</label>
                    <input type="date" name="FechaEvento" class="form-control" required>
                </div>
             <div style="text-align: right; padding-top: 1rem; border-top: 1px solid #eee;">
                <button type="button" onclick="document.getElementById('modal-backdrop').remove()"  class="btn-cancel-modal">Cancelar</button>
                <button type="submit" class="btn-save-modal">Guardar</button>
            </div>
        </form>
    </div>
</div>