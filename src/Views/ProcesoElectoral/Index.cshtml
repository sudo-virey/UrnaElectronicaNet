@model List<UrnaElectronica.Models.ProcesoElectoral>
@using UrnaElectronica.Controllers
@{
    ViewData["Title"] = "Procesos Electorales";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery


<div class="page-header" style="margin-bottom: 2rem;">
    <h1>Procesos Electorales</h1>
    <p class="subtitle">Gestión de elecciones y configuración de cierre</p>
</div>

<div style="margin: 2rem 0;">
    <button hx-get="/ProcesoElectoral/Create" hx-target="#modal-container" class="btn-primary-action" style="border:none; cursor:pointer;">
        <i class="fas fa-plus"></i> Registrar Proceso
    </button>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Fecha Evento</th>
                <th>Estado</th>
                <th style="text-align:right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var proceso in Model)
            {
                <tr>
                    <td><strong>@proceso.Nombre</strong></td>
                    <td>@(proceso.FechaEvento?.ToString("dd/MM/yyyy") ?? "No asignada")</td>
                    <td>
                         @if (proceso.IdEstatus == 1)
                        {
                            @* Cambia 'badge-success' por 'badge-activo' si usas tus estilos personalizados *@
                            <span class="badge badge-success" style="background-color: #d4edda; color: #155724; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">ACTIVO</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary" style="background-color: #e2e3e5; color: #383d41; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">FINALIZADO</span>
                        }
                    </td>
                    <td style="text-align:right;">
                        <button type="button"
                                onclick="window.location.href='@Url.Action("Details", "ProcesoElectoral", new { id = proceso.Id })'"
                                class="btn-icon"
                                style="background:none; border:none; cursor:pointer;"
                                title="Ver detalles del proceso">
                            <i class="fas fa-eye"></i>
                        </button>


                        <button hx-get="/ProcesoElectoral/Edit/@proceso.Id" hx-target="#modal-container" 
                         class="btn-icon" 
                                style="background:none; border:none; cursor:pointer;">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button hx-post="/ProcesoElectoral/Delete/@proceso.Id"
                                hx-confirm="¿Deseas eliminar este proceso electoral?"
                                hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'
                                class="btn-icon" 
                                 style="color: #dc3545; margin-left: 10px; background:none; border:none; cursor:pointer;">
                           
                            <i class="fas fa-trash-alt"></i>
                            </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal-container"></div>