@model UrnaElectronica.Models.Urna
@{ Layout = null; }

<div id="modal-backdrop" class="custom-modal-backdrop">
    <div class="custom-modal-content">
        <h3 style="margin-top: 0; color: #333;">Editar Urna: @Model.Nombre</h3> 
        <hr style="border: 0; border-top: 1px solid #eee; margin: 1rem 0;" />
        
        <form hx-post="/Urna/Edit/@Model.Id_Urna" hx-target="#modal-container"> 
            @Html.AntiForgeryToken() 
            <input type="hidden" asp-for="Id_Urna" /> 
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Nombre / Código</label>
                <input asp-for="Nombre" class="form-control" 
                       style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: 6px;" required />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Modelo</label>
                <input asp-for="Modelo" class="form-control" 
                       style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: 6px;" required />
            </div>

            <div style="margin-bottom: 2rem; padding: 1rem; background-color: #f8f9fa; border-radius: 8px; border: 1px solid #eee;">
                <label style="display: flex; align-items: center; gap: 12px; cursor: pointer; font-weight: 600;">
                    <input type="checkbox" asp-for="Activo" style="width: 18px; height: 18px; cursor: pointer;" />
                    <span>Estado Operativo</span>
                </label>
                <p style="margin: 5px 0 0 30px; font-size: 0.85rem; color: #666; line-height: 1.2;">
                    Indica si la urna está disponible para ser asignada a un proceso electoral.
                </p>
            </div>

            <div style="text-align: right; padding-top: 1rem; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" 
                        onclick="document.getElementById('modal-container').innerHTML=''" 
                        style="padding: 0.6rem 1.2rem; border-radius: 6px; border: 1px solid #ccc; background: #fff; cursor: pointer; font-weight: 600;">
                    Cancelar
                </button>
                <button type="submit" 
                        style="padding: 0.6rem 1.5rem; border-radius: 6px; border: none; background: #ffc107; color: #000; cursor: pointer; font-weight: bold;">
                    Actualizar
                </button>
            </div>
        </form>
    </div>
</div>