@model IEnumerable<UrnaElectronica.Models.Urna>
@{
    ViewData["Title"] = "Gestión de Urnas";
}

<div class="page-header">
    <h1>Urnas Electrónicas</h1>
    <p class="subtitle">Gestión y monitoreo de dispositivos de votación</p>
</div>



<div style="margin-bottom: 2rem;">
    <button hx-get="/Urna/Create" hx-target="#modal-container" class="btn-primary-action" style="border:none; cursor:pointer;">
        + Registrar Urna
    </button>
</div>



<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Código/Nombre</th>
                <th>Modelo</th>
                <th>Estado</th>
                <th style="text-align: right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Nombre</strong></td>
                    <td>@item.Modelo</td>
                    <td>
                         @if (item.Activo)
                        {
                            @* Cambia 'badge-success' por 'badge-activo' si usas tus estilos personalizados *@
                            <span class="badge badge-success" style="background-color: #d4edda; color: #155724; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">ACTIVO</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary" style="background-color: #e2e3e5; color: #383d41; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">INACTIVO</span>
                        }
                    </td>
                    <td style="text-align: right;">
                        <button hx-get="/Urna/Edit/@item.Id_Urna" hx-target="#modal-container" class="btn-icon"style="background:none; border:none; cursor:pointer;">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button hx-post="/Urna/Delete/@item.Id_Urna" hx-confirm="¿Eliminar esta urna?" class="btn-icon"  style="color: #dc3545; margin-left: 10px; background:none; border:none; cursor:pointer;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal-container"></div>