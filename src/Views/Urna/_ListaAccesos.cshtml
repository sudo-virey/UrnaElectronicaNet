@model IEnumerable<UrnaElectronica.Models.Acceso>
@{ Layout = null; }

<div class="custom-modal-backdrop">
    <div class="custom-modal-content" style="max-width: 750px; width: 95%;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div class="page-header" style="margin: 0;">
                <h2 style="font-size: 1.4rem; color: var(--primary-dark); margin: 0;">Gestión de Accesos</h2>
                <p style="font-size: 0.85rem; color: var(--text-light); margin: 0;">Urna: @ViewBag.UrnaNombre</p>
            </div>
            <button onclick="window.print()" class="btn-primary-action" style="padding: 0.6rem 1rem; font-size: 0.9rem;">
                <i class="fas fa-print"></i> Imprimir
            </button>
        </div>
        
        <hr style="border: 0; border-top: 1px solid var(--border-color); margin-bottom: 1.5rem;" />

        <div class="form-status-container" style="text-align: center; border-style: solid; background: #fdfaf0;">
            <form hx-post="/Urna/GenerarAccesoUnico" hx-target="#modal-container">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idUrna" value="@ViewBag.IdUrna" />
                
                <p style="margin-bottom: 1rem; font-size: 0.9rem; color: var(--text-dark);">
                    Generar un nuevo <strong>hash de seguridad único</strong> para esta urna.
                </p>
                
                <button type="submit" class="btn-save-modal" style="display: inline-flex; align-items: center; gap: 8px;">
                    <i class="fas fa-shield-alt"></i> Generar Token de Acceso
                </button>
            </form>
        </div>

        <div class="table-container" style="max-height: 350px; box-shadow: none; border: 1px solid var(--border-color);">
            <table class="table">
                <thead style="position: sticky; top: 0; z-index: 10;">
                    <tr>
                        <th>Hash Único (Token)</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 2rem; color: var(--text-light);">
                                No hay tokens generados para esta urna.
                            </td>
                        </tr>
                    }
                    @foreach (var acceso in Model)
                    {
                        <tr>
                            <td>
                                <code style="color: var(--primary-dark); font-weight: bold; font-family: monospace; font-size: 1rem;">
                                    @acceso.Codigo
                                </code>
                            </td>
                            <td>
                                @if (acceso.Activo)
                                {
                                    <span class="badge badge-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" style="background:#eee; color:#666;">Inactivo</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <button hx-post="/Urna/EliminarAcceso/@acceso.Id_Acceso" 
                                        hx-target="#modal-container"
                                        hx-confirm="¿Deseas revocar este token permanentemente?"
                                        class="btn-icon" style="color: #dc3545; border:none; background:none; cursor:pointer;">
                                    <i class="fas fa-times-circle"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="modal-footer-actions" style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
            <button type="button" onclick="document.getElementById('modal-container').innerHTML=''" class="btn-cancel-modal">
                Cerrar Panel
            </button>
        </div>
    </div>
</div>