@model IEnumerable<UrnaElectronica.Models.Acceso>
@{ Layout = null; }

<style>
    /* Estilos para el modal en pantalla */
    .btn-print-qr {
        background-color: #28a745;
        color: white;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        border: none;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.3s;
    }
    .btn-print-qr:hover { background-color: #218838; }

    /* Contenedor "Fantasma": Evita que la tabla salte al presionar imprimir */
    #printable-grid {
        position: absolute;
        left: -9999px; /* Fuera de la pantalla para el usuario */
        top: 0;
        display: none; 
    }

    /* ESTILOS DE IMPRESIÓN REAL (Planilla 4x5) */
    @@media print {
        body * { visibility: hidden !important; }
        
        #printable-grid, #printable-grid * { 
            visibility: visible !important; 
        }

        #printable-grid {
            display: grid !important; 
            grid-template-columns: repeat(4, 1fr); 
            gap: 10px;
            position: absolute;
            left: 0 !important; /* Lo regresamos al papel */
            top: 0;
            width: 100%;
        }

        .qr-card {
            border: 1px solid #ccc;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            height: 220px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            page-break-inside: avoid;
        }

        .qr-label {
            font-size: 10pt;
            font-weight: bold;
            margin-bottom: 5px;
            text-transform: uppercase;
        }
    }
</style>

<div class="custom-modal-backdrop">
    <div class="custom-modal-content" style="max-width: 850px; width: 95%;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
                <h2 style="color: var(--primary-dark); margin: 0;">Planilla de Accesos</h2>
                <p style="color: var(--text-light); margin: 0;">Urna: @ViewBag.UrnaNombre</p>
            </div>
            <button type="button" onclick="window.prepararImpresion()" class="btn-print-qr">
                <i class="fas fa-print"></i> Imprimir Planilla (4x5)
            </button>
        </div>
        
        <hr style="border: 0; border-top: 1px solid var(--border-color); margin-bottom: 1.5rem;" />

        <div class="form-status-container" style="display: flex; justify-content: center; gap: 15px; background: #fdfaf0; border-style: solid; padding: 1.2rem;">
            <form hx-post="/Urna/GenerarAccesoUnico" hx-target="#modal-container">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idUrna" value="@ViewBag.IdUrna" />
                <button type="submit" class="btn-save-modal" style="font-size: 0.85rem;">
                    <i class="fas fa-plus"></i> Generar 1
                </button>
            </form>
            <form hx-post="/Urna/GenerarLote" hx-target="#modal-container">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idUrna" value="@ViewBag.IdUrna" />
                @* Usamos la clase btn-save-modal que ya tiene el color dorado (#B19012) *@
                <button type="submit" class="btn-save-modal" style="font-size: 0.85rem; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-layer-group"></i> Generar Lote (20)
                </button>
            </form>
        </div>

        <div class="table-container" style="max-height: 250px; overflow-y: auto; border: 1px solid var(--border-color); margin-top: 1rem;">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Token (Hash)</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var acceso in Model) {
                        <tr>
                            <td><strong>@i.ToString("D2")</strong></td>
                            <td><code style="color: var(--primary-dark); font-weight: bold;">@acceso.Codigo</code></td>
                            <td style="text-align: right;">
                                <button hx-post="/Urna/EliminarAcceso/@acceso.Id_Acceso" 
                                        hx-target="#modal-container" 
                                        hx-confirm="¿Revocar este token?"
                                        class="btn-icon" style="color:#dc3545; border:none; background:none; cursor:pointer;">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>

        <div id="printable-grid">
            @{ int count = 1; }
            @foreach (var acceso in Model) {
                <div class="qr-card">
                    <div class="qr-label">@count.ToString("D2")-@ViewBag.UrnaNombre</div>
                    <div class="qr-code-div" data-code="@acceso.Codigo"></div>
                </div>
                count++;
            }
        </div>

        <div class="modal-footer-actions">
            <button type="button" onclick="document.getElementById('modal-container').innerHTML=''" class="btn-cancel-modal">Cerrar</button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
    window.prepararImpresion = function() {
        const divs = document.querySelectorAll('.qr-code-div');
        const grid = document.getElementById('printable-grid');

        if (divs.length === 0) {
            alert("No hay códigos para imprimir.");
            return;
        }

        // 1. Despertar el grid (está en left: -9999px así que no se nota)
        grid.style.display = "grid";

        // 2. Generar los QRs
        divs.forEach(div => {
            div.innerHTML = ""; 
            new QRCode(div, {
                text: div.getAttribute('data-code'),
                width: 115,
                height: 115,
                correctLevel : QRCode.CorrectLevel.H
            });
        });

        // 3. Pequeño delay para asegurar que el canvas de QRCode se dibuje
        setTimeout(() => {
            window.print();
            grid.style.display = "none"; 
        }, 800);
    };
</script>