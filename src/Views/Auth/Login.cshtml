@using UrnaElectronica.Models
@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // Sin layout
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Urna Electrónica</title>
    <link href="~/css/login.css" rel="stylesheet" />
</head>

<body>
    <div class="login-container">
        <div class="login-header">
            <div class="login-icon">
                <img src="~/images/icon.png" alt="Icono Urna Electrónica">
                </div>
                <h1>Iniciar sesión</h1>
                <!-- <p>Inicio de sesión</p>-->
            </div>


            @{
                var motivo = Context.Request.Query["motivo"].ToString();
            }
            @if (motivo == "expirada")
            {
                <div class="error-message" style="background:#fff3cd; color:#856404; border:1px solid #ffeeba; padding:0.7em 1em; border-radius:8px; margin-bottom:1em; font-weight:600;">
                    Tu sesión ha expirado por inactividad. Por favor, inicia sesión nuevamente.
                </div>
            }

            @if (Model != null && !ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                @foreach (var modelState in ViewData.ModelState.Values)
                {
                    @foreach (var error in modelState.Errors)
                    {
                        <div class="error-message">@error.ErrorMessage</div>
                    }
                }
            }

            <form method="post" action="/Auth/Login">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="Email">Correo Electrónico</label>
                    <input type="email" id="Email" name="Email" class="form-control" value="@(Model?.Email ?? "")"
                           required />
                    @if (Model != null && !ViewData.ModelState.IsValid && ViewData.ModelState["Email"]?.Errors.Count > 0)
                    {
                        <div class="validation-error">
                            @ViewData.ModelState["Email"]?.Errors[0]?.ErrorMessage
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label for="Contraseña">Contraseña</label>
                    <div class="password-input-group">
                        <input type="password" id="Contraseña" name="Contraseña" class="form-control" required />
                        <button type="button" class="toggle-password" id="togglePassword"
                                aria-label="Mostrar/ocultar contraseña">
                            <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="eye-off-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 style="display:none;">
                                <path
                                    d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24">
                                </path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    @if (Model != null && !ViewData.ModelState.IsValid && ViewData.ModelState["Contraseña"]?.Errors.Count >
                                    0)
                    {
                        <div class="validation-error">
                            @ViewData.ModelState["Contraseña"]?.Errors[0]?.ErrorMessage
                        </div>
                    }
                </div>

                <label class="remember-me-container">
                    <input type="checkbox" name="RememberMe">
                    <span>Recuérdame</span>
                </label>

                <button type="submit" class="btn-login">Iniciar Sesión</button>
            </form>

        </div>

        <footer class="app-footer">
            <p>&copy; 2026 IETAM - Instituto Electoral de Tamaulipas. Todos los derechos reservados.</p>
        </footer>

        <script src="~/js/main.js"></script>
    </body>

</html>