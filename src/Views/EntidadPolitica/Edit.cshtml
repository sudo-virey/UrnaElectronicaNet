@model UrnaElectronica.Models.Partido
@{ Layout = null; }

<div id="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 9999;">
    <div style="background: white; padding: 2rem; border-radius: 12px; width: 500px; max-width: 95%; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
        <h3 style="margin-top: 0; color: #333;">Editar Entidad</h3>
        <hr />
        
        <form hx-post="/EntidadPolitica/Edit/@Model.Id_Partido" hx-target="#modal-container">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id_Partido" />

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600;">Nombre de la Entidad</label>
                <input asp-for="Nombre" class="form-control" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: 6px;" required />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                    <label style="display: block; font-weight: 600;">Siglas</label>
                    <input asp-for="Siglas" class="form-control" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: 6px;" />
                </div>
                <div>
                    <label style="display: block; font-weight: 600;">Tipo</label>
                    <select asp-for="Tipo" class="form-select" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: 6px;">
                        <option value="Partido">Partido</option>
                        <option value="Coalición">Coalición</option>
                        <option value="Movimiento">Movimiento</option>
                        <option value="Independiente">Independiente</option>
                    </select>
                </div>
            </div>

            @* --- NUEVO CAMPO DE ESTADO --- *@
            <div style="margin-bottom: 1.5rem; background: #f8f9fa; padding: 0.8rem; border-radius: 8px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 600; color: #333;">
                    <input type="checkbox" asp-for="Estado" style="width: 18px; height: 18px; cursor: pointer;" />
                    <span>¿Entidad Activa?</span>
                </label>
                <small style="display: block; color: #666; margin-left: 28px;">Si se desmarca, la entidad no aparecerá en las boletas electorales.</small>
            </div>

            <div style="text-align: right; padding-top: 1rem; border-top: 1px solid #eee;">
                <button type="button" onclick="document.getElementById('modal-backdrop').remove()" 
                        class="btn-cancel-modal">
                    Cancelar
                </button>
                <button type="submit" class="btn-save-modal">
                    Actualizar Cambios
                </button>
            </div>
        </form>
    </div>
</div>