@* Encabezado Dinámico *@
@{
    ViewData["Title"] = "Entidades Políticas";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="color: var(--primary-dark);">Entidades Políticas</h1>
    <p class="text-light">Gestión y monitoreo de partidos, movimientos y coaliciones.</p>
</div>

<div class="dashboard-grid">
    <div class="stat-card">
        <p class="stat-label">Total Entidades</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 class="stat-value">@ViewBag.TotalEntidades</h2>
            <span style="font-size: 1.5rem;">🏛️</span>
        </div>
    </div>
    
    <div class="stat-card" style="border-left-color: #17a2b8;">
        <p class="stat-label">Candidatos Registrados</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 class="stat-value">@ViewBag.TotalCandidatos</h2>
            <span style="font-size: 1.5rem;">👥</span>
        </div>
    </div>
</div>

<div style="margin: 2rem 0;">
    <a href="/EntidadPolitica/Create" class="btn-primary-action">
        <i class="fas fa-plus"></i> Registrar Nueva Entidad
    </a>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre de la Entidad</th>
                <th>Siglas</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th style="text-align: right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entidad in Model) {
                <tr>
                    <td><strong>@entidad.Nombre</strong></td>
                    <td><span class="badge-siglas">@entidad.Siglas</span></td>
                    <td>@entidad.Tipo</td>
                    <td>
                        <span class="badge @(entidad.Estado == "Activo" ? "badge-success" : "badge-danger")">
                            @entidad.Estado
                        </span>
                    </td>
                    <td style="text-align: right;">
                        <a href="/EntidadPolitica/Edit/@entidad.Id" class="btn-icon" title="Editar"><i class="fas fa-edit"></i></a>
                        <a href="/EntidadPolitica/Details/@entidad.Id" class="btn-icon" title="Detalles"><i class="fas fa-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>