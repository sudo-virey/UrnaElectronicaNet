@model IEnumerable<UrnaElectronica.Models.Partido>
@{
    ViewData["Title"] = "Entidades Políticas";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="color: var(--primary-dark);">Entidades Políticas</h1>
    <p class="text-light">Gestión y monitoreo de partidos, movimientos y coaliciones.</p>
</div>

<div class="dashboard-grid">
    <div class="stat-card">
        <p class="stat-label">Total Entidades</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 class="stat-value">@ViewBag.TotalEntidades</h2>
            <span style="font-size: 1.5rem;">🏛️</span>
        </div>
    </div>
</div>

<div style="margin: 2rem 0;">
    <button hx-get="/EntidadPolitica/Create" hx-target="#modal-container" class="btn-primary-action" style="border:none; cursor:pointer;">
        <i class="fas fa-plus"></i> Registrar Nueva Entidad
    </button>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Siglas</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th style="text-align: right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var partido in Model)
            {
                <tr>
                    <td><strong>@partido.Nombre</strong></td>
                    <td><span class="badge-siglas">@partido.Siglas</span></td>
                    <td>@partido.Tipo</td>
                    <td>
                        @if (partido.Estado)
                        {
                            @* Cambia 'badge-success' por 'badge-activo' si usas tus estilos personalizados *@
                            <span class="badge badge-success" style="background-color: #d4edda; color: #155724; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">ACTIVO</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary" style="background-color: #e2e3e5; color: #383d41; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">INACTIVO</span>
                        }
                    </td>
                   <td style="text-align: right;">
                        <button hx-get="/EntidadPolitica/Edit/@partido.Id_Partido" 
                                hx-target="#modal-container" 
                                class="btn-icon" 
                                style="background:none; border:none; cursor:pointer;">
                            <i class="fas fa-edit"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal-container"></div>