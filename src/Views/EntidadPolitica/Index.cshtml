@* Encabezado Dinámico *@
@{
    ViewData["Title"] = "Entidades Políticas";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <h1 style="color: var(--primary-dark);">Entidades Políticas</h1>
    <p class="text-light">Gestión y monitoreo de partidos, movimientos y coaliciones.</p>
</div>

<div class="dashboard-grid">
    <div class="stat-card">
        <p class="stat-label">Total Entidades</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 class="stat-value">@ViewBag.TotalEntidades</h2>
            <span style="font-size: 1.5rem;">🏛️</span>
        </div>
    </div>
    
    <div class="stat-card" style="border-left-color: #17a2b8;">
        <p class="stat-label">Candidatos Registrados</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 class="stat-value">@ViewBag.TotalCandidatos</h2>
            <span style="font-size: 1.5rem;">👥</span>
        </div>
    </div>
</div>

<div style="margin: 2rem 0;">
    <a href="/EntidadPolitica/Create" class="btn-primary-action">
        <i class="fas fa-plus"></i> Registrar Nueva Entidad
    </a>
</div>

@model IEnumerable<UrnaElectronica.Models.Partido>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Siglas</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th style="text-align: right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var partido in Model)
            {
                <tr>
                    <td><strong>@partido.Nombre</strong></td>
                    <td><span class="badge-siglas">@partido.Siglas</span></td>
                    <td>@partido.Tipo</td>
                    <td>
                        @if (partido.Estado) {
                            <span class="badge badge-success">Activo</span>
                        } else {
                            <span class="badge badge-danger">Inactivo</span>
                        }
                    </td>
                    <td style="text-align: right;">
                        <a href="/Partidos/Edit/@partido.Id_Partido" class="btn-icon"><i class="fas fa-edit"></i></a>
                        <a href="/Partidos/Details/@partido.Id_Partido" class="btn-icon"><i class="fas fa-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>