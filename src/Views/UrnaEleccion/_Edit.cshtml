@model UrnaElectronica.Models.UrnaEleccion
@{
    Layout = null;
    var urnas = ViewBag.Urnas as IEnumerable<UrnaElectronica.Models.Urna> ?? Enumerable.Empty<UrnaElectronica.Models.Urna>();
    var estatus = ViewBag.Estatus as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div id="modal-backdrop" class="app-modal-backdrop">
    <div class="app-modal app-modal--lg">
        <h3 class="app-modal__title">Editar Asignación de Urna</h3>
        <p class="app-modal__subtitle">Actualiza estatus, fechas y activación de la urna en esta elección.</p>
        <hr />

        <form hx-post="/UrnaEleccion/Edit/@Model.IdUrnaEleccion" hx-target="#modal-container">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdUrnaEleccion" value="@Model.IdUrnaEleccion" />
            <input type="hidden" name="IdEleccion" value="@Model.IdEleccion" />
            <input type="hidden" name="Eliminado" value="@Model.Eliminado" />
            <input type="hidden" name="IdEstatusUrna" value="@Model.IdEstatusUrna" />

            @Html.ValidationSummary(false, "", new { @class = "text-danger small mb-2" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Urna</label>
                    <select name="IdUrna" class="form-select" required>
                        @if (!urnas.Any(u => u.Id_Urna == Model.IdUrna))
                        {
                            <option value="@Model.IdUrna" selected>Urna asignada #@Model.IdUrna</option>
                        }

                        <option value="">Seleccione urna...</option>
                        @foreach (var urna in urnas)
                        {
                            @if (urna.Id_Urna == Model.IdUrna)
                            {
                                <option value="@urna.Id_Urna" selected>@urna.Nombre</option>
                            }
                            else
                            {
                                <option value="@urna.Id_Urna">@urna.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label>Lista Nominal</label>
                    <input type="number" name="ListaNominal" min="0" class="form-control" value="@Model.ListaNominal" required />
                </div>
            </div>



            <div class="row mb-3">
                <div class="col-md-6">
                    <small class="text-muted d-block">Fecha/Hora Inicio</small>
                    <strong>@(Model.FechaHoraInicio?.ToString("dd/MM/yyyy HH:mm") ?? "Sin iniciar")</strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Fecha/Hora Fin</small>
                    <strong>@(Model.FechaHoraFin?.ToString("dd/MM/yyyy HH:mm") ?? "Sin finalizar")</strong>
                </div>
            </div>

            <div class="form-status-container mb-3">
                <label class="form-check-label">
                    <input asp-for="Activo" type="checkbox" />
                    <span>Asignación activa</span>
                </label>
            </div>

            <div class="app-modal__footer">
                <button type="button" onclick="document.getElementById('modal-backdrop').remove()" class="btn-cancel-modal">Cancelar</button>
                <button type="submit" class="btn-save-modal">Actualizar Cambios</button>
            </div>
        </form>
    </div>
</div>
