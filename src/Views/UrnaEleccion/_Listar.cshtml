@model IEnumerable<UrnaElectronica.Models.UrnaEleccion>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ Layout = null; }

@{
    var urnasMap = ViewBag.UrnasMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var estatusMap = ViewBag.EstatusMap as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="inline-panel inline-panel--urnas">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="inline-panel__title text-info"><i class="fas fa-tablet-alt me-1"></i> Urnas Asignadas</h6>
        <button hx-get="/UrnaEleccion/Create?eleccionId=@ViewBag.IdEleccion"
                hx-target="#modal-container"
                class="btn-primary-action" style="border:none; cursor:pointer;">
            <i class="fas fa-plus"></i> Asignar Urna
        </button>
    </div>

    @if (!Model.Any())
    {
        <p class="inline-panel__empty">No hay urnas asignadas en esta elección.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Urna</th>
                        <th>Lista Nominal</th>
                        <th>Estatus</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@(urnasMap.ContainsKey(item.IdUrna) ? urnasMap[item.IdUrna] : $"Urna #{item.IdUrna}")</strong></td>
                            <td>@item.ListaNominal</td>
                            <td>@(estatusMap.ContainsKey(item.IdEstatusUrna) ? estatusMap[item.IdEstatusUrna] : "Desconocido")</td>
                            <td>@(item.FechaHoraInicio?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>@(item.FechaHoraFin?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge" style="background-color: #d4edda; color: #155724;">Sí</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #e2e3e5; color: #383d41;">No</span>
                                }
                            </td>
                            <td class="text-end">
                                <button hx-get="/UrnaEleccion/Edit/@item.IdUrnaEleccion"
                                        hx-target="#modal-container"
                                        class="btn btn-link btn-sm text-primary p-0 me-2"
                                        title="Editar asignación">
                                    <i class="fas fa-edit"></i>
                                </button>

                                <button hx-post="/UrnaEleccion/Delete/@item.IdUrnaEleccion?eleccionId=@ViewBag.IdEleccion"
                                        hx-target="#urnas-area-@ViewBag.IdEleccion"
                                        hx-swap="innerHTML"
                                        hx-confirm="¿Eliminar asignación de urna?"
                                        hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'
                                        class="btn btn-link btn-sm text-danger p-0"
                                        title="Eliminar asignación">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
