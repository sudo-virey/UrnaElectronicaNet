<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Urna Electrónica</title>
    <link rel="icon" type="image/png" href="~/images/icon.png">
    
    <link href="~/css/style.css" rel="stylesheet" />
    <link href="~/css/layout-components.css" rel="stylesheet" />
    
    <script src="https://unpkg.com/htmx.org"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <div id="sidebar-overlay" onclick="toggleMobileMenu()"></div>

    <div class="app-container">
        <aside class="sidebar" id="main-sidebar">
            <div class="sidebar-header">
                <div class="logo-row">
                    <img src="~/images/icon.png" alt="Logo" class="sidebar-logo-img">
                    <div class="logo-text-stack">
                        <h2>IETAM</h2>
                        <p>Urna Electrónica</p>
                    </div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/Home" class="nav-item"><i class="fas fa-tachometer-alt"></i> <span class="nav-label">Dashboard</span></a></li>
                    <li><a href="/ProcesoElectoral" class="nav-item"><i class="fas fa-vote-yea"></i> <span class="nav-label">Procesos</span></a></li>
                    <li><a href="/Urna" class="nav-item"><i class="fas fa-box"></i> <span class="nav-label">Urnas</span></a></li>
                    <li><a href="/Impresora" class="nav-item"><i class="fas fa-print"></i> <span class="nav-label">Impresoras</span></a></li>
                    <li><a href="/EntidadPolitica" class="nav-item"><i class="fas fa-landmark"></i> <span class="nav-label">Partidos</span></a></li>
                </ul>
            </nav>
    
        </aside>

        <div class="main-content">
            <header class="top-header">
                <div class="header-left">
                    <button class="mobile-menu-btn" onclick="toggleMobileMenu()">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
                
                <div class="header-right">
                    @if (Context.Session.GetString("UsuarioNombre") != null)
                    {
                        <div class="user-profile-header">
                            <span class="welcome-text">Hola, <strong>@Context.Session.GetString("UsuarioNombre")</strong></span>
                            <div class="header-divider"></div>
                            <a href="/Auth/Logout" class="logout-header-btn" title="Cerrar Sesión">
                                <i class="fas fa-sign-out-alt"></i>
                                <span class="logout-label">Salir</span>
                            </a>
                        </div>
                    }
                </div>
            </header>

            <main class="content-area" id="content-area">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <p>&copy; 2026 IETAM - Instituto Electoral de Tamaulipas.</p>
            </footer>
        </div>
    </div>

    <script>
        function toggleMobileMenu() {
            document.getElementById('main-sidebar').classList.toggle('mobile-active');
            document.getElementById('sidebar-overlay').classList.toggle('active');
        }
    </script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* ESTA ES LA LÍNEA QUE FALTA *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>