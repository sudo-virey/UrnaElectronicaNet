@model IEnumerable<UrnaElectronica.Models.Impresora>
@{
    ViewData["Title"] = "Impresoras de Auditoría";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<div class="page-header" style="margin-bottom: 2rem;">
    <h1>Impresoras de Auditoría</h1>
    <p>Gestión y configuración de equipos de impresión para máquinas de votación.</p>
</div>

<div style="margin: 2rem 0;">
    <button hx-get="/Impresora/Create" hx-target="#modal-container" class="btn-primary-action" style="border:none; cursor:pointer;">
        <i class="fas fa-plus"></i> Registrar Impresora
    </button>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Identificador</th>
                <th>MAC</th>
                <th>Estado</th>
                <th style="text-align: right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Nombre</strong></td>
                    <td><code>@item.Mac</code></td>
                    <td>
                          @if (item.Activo)
                        {
                            @* Cambia 'badge-success' por 'badge-activo' si usas tus estilos personalizados *@
                            <span class="badge badge-success" style="background-color: #d4edda; color: #155724; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">ACTIVO</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary" style="background-color: #e2e3e5; color: #383d41; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.75rem;">INACTIVO</span>
                        }
                    </td>
                    <td style="text-align: right;">
                        <button hx-get="/Impresora/Edit/@item.Id_Impresora" 
                                hx-target="#modal-container" 
                                class="btn-icon" 
                                style="background:none; border:none; cursor:pointer;">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button hx-post="/Impresora/Delete/@item.Id_Impresora"
                                hx-confirm="¿Deseas dar de baja esta impresora del catálogo?"
                                hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'
                                class="btn-icon" 
                                style="color: #dc3545; margin-left: 10px; background:none; border:none; cursor:pointer;">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal-container"></div>