@model UrnaElectronica.Models.Impresora
@{ Layout = null; }

<div id="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 9999;">
    <div style="background: white; padding: 2rem; border-radius: 12px; width: 500px; max-width: 95%; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
        <h3 style="margin-top: 0; color: #333;">Editar Impresora</h3>
        <hr />
        
        <form hx-post="/Impresora/Edit/@Model.Id_Impresora" hx-target="#modal-container">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id_Impresora" />

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600;">Identificador / Nombre</label>
                <input asp-for="Nombre" class="form-control" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: 6px;" required />
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600;">Dirección MAC</label>
                <input asp-for="Mac" class="form-control" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: 6px;" required />
                <p class="form-help-text">El ID físico único del equipo.</p>
            </div>

            <div class="form-status-container">
                <label class="form-check-label">
                    <input type="checkbox" asp-for="Activo" />
                    <span>¿Equipo listo para operación?</span>
                </label>
            </div>

            <div style="text-align: right; padding-top: 1rem; border-top: 1px solid #eee;">
                <button type="button" onclick="document.getElementById('modal-backdrop').remove()" 
                        class="btn-cancel-modal">
                    Cancelar
                </button>
                <button type="submit" class="btn-save-modal">
                    Actualizar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
