@model Candidato
@{ Layout = null; }
@{
    var partidos = ViewBag.Partidos as IEnumerable<UrnaElectronica.Models.Partido> ?? Enumerable.Empty<UrnaElectronica.Models.Partido>();
}

<div id="modal-backdrop" class="app-modal-backdrop">
    <div class="app-modal app-modal--md">
        <h3 class="app-modal__title">Nuevo Candidato</h3>
        <p class="app-modal__subtitle">Complete la información del candidato para esta elección.</p>
        <hr />

        <form hx-post="/Candidato/Create" enctype="multipart/form-data" hx-target="#modal-container">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdEleccion" value="@Model.IdEleccion" />

            <div class="app-modal__field">
                <label>Nombre del Candidato</label>
                <input type="text" name="Nombre" class="form-control" required />
            </div>

            <div class="app-modal__field">
                <label>Partido (opcional)</label>
                <select name="IdPartido" class="form-select">
                    <option value="">Sin partido</option>
                    @foreach (var partido in partidos)
                    {
                        <option value="@partido.Id_Partido">@partido.Nombre</option>
                    }
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Color de Fondo (Hex)</label>
                    <input type="color" name="ColorFondo" class="form-control" value="#ffffff" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Color de Texto (Hex)</label>
                    <input type="color" name="ColorTexto" class="form-control" value="#000000" />
                </div>
            </div>

            <div class="app-modal__field">
                <label>Logo/Fotografía</label>
                <div class="app-upload-box">
                    <input type="file"
                           name="FotoFile"
                           class="form-control js-candidato-foto-input"
                           accept="image/*"
                           data-preview-wrap-id="foto-preview-wrap-create"
                           data-preview-img-id="foto-preview-img-create"
                           data-file-name-id="foto-file-name-create" />
                    <small id="foto-file-name-create" class="text-muted d-block mt-2">Sin archivo seleccionado.</small>

                    <div id="foto-preview-wrap-create" style="display: none; margin-top: 0.75rem;">
                        <small class="text-muted d-block">Vista previa</small>
                        <img id="foto-preview-img-create"
                             src=""
                             alt="Vista previa"
                             class="app-upload-preview" />
                    </div>
                </div>
            </div>

            <div class="app-modal__footer">
                <button type="button" onclick="document.getElementById('modal-backdrop').remove()" class="btn-cancel-modal">Cancelar</button>
                <button type="submit" class="btn-save-modal">Guardar</button>
            </div>
        </form>
    </div>
</div>