@model IEnumerable<Candidato>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ Layout = null; }
@{
    var partidosMap = ViewBag.PartidosMap as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="inline-panel inline-panel--candidatos">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="inline-panel__title text-institutional"><i class="fas fa-users me-1"></i> Candidatos Registrados</h6>
        <button hx-get="/Candidato/Create?eleccionId=@ViewBag.IdEleccion" 
                hx-target="#modal-container" 
                class="btn-primary-action" style="border:none; cursor:pointer;">
            <i class="fas fa-plus"></i> Agregar Candidato
        </button>
    </div>

    @if (!Model.Any())
    {
        <p class="inline-panel__empty">No hay candidatos registrados en esta elección.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Foto</th>
                        <th>Nombre</th>
                        <th>Partido</th>
                        <th>Colores (T/F)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FotoRuta))
                                {
                                    <img src="@item.FotoRuta" alt="Logo" class="inline-avatar">
                                }
                                else
                                {
                                    <i class="fas fa-user-circle text-muted fa-lg"></i>
                                }
                            </td>
                            <td><strong>@item.Nombre</strong></td>
                            <td>
                                @if (item.IdPartido.HasValue && partidosMap.ContainsKey(item.IdPartido.Value))
                                {
                                    @partidosMap[item.IdPartido.Value]
                                }
                                else
                                {
                                    <span class="text-muted">Sin partido</span>
                                }
                            </td>
                            <td>
                                <span class="badge inline-color-chip" style="background-color:@item.ColorFondo; color:@item.ColorTexto;">Abc</span>
                            </td>
                            <td class="text-end">
                                <button hx-get="/Candidato/Edit/@item.Id" hx-target="#modal-container" class="btn-icon btn-no-bg ml-10" title="Editar candidato">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button hx-post="/Candidato/Delete/@item.Id?eleccionId=@ViewBag.IdEleccion"
                                    hx-target="#candidatos-area-@ViewBag.IdEleccion"
                                    hx-swap="innerHTML"
                                    hx-confirm="¿Eliminar a @item.Nombre?"
                                    hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'
                                    class="btn-icon btn-no-bg ml-10 text-danger" title="Eliminar candidato">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>