@model IEnumerable<Candidato>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ Layout = null; }

<div class="mt-3 p-3 border-start border-4" style="background-color: #fdfdfd; border-color: #007bff !important;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold text-primary mb-0"><i class="fas fa-users me-1"></i> Candidatos Registrados</h6>
        <button hx-get="/Candidato/Create?eleccionId=@ViewBag.IdEleccion" 
                hx-target="#modal-container" 
                class="btn btn-sm btn-success">
            <i class="fas fa-plus"></i> Agregar Candidato
        </button>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted small italic">No hay candidatos registrados en esta elección.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Foto</th>
                        <th>Nombre</th>
                        <th>Colores (T/F)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.FotoRuta))
                                {
                                    <img src="@item.FotoRuta" alt="Logo" style="width: 30px; height: 30px; object-fit: cover; border-radius: 50%;">
                                }
                                else
                                {
                                    <i class="fas fa-user-circle text-muted fa-lg"></i>
                                }
                            </td>
                            <td><strong>@item.Nombre</strong></td>
                            <td>
                                <span class="badge border" style="background-color:@item.ColorFondo; color:@item.ColorTexto;">Abc</span>
                            </td>
                            <td class="text-end">
                                <button hx-get="/Candidato/Edit/@item.Id" hx-target="#modal-container" class="btn btn-link btn-sm text-primary p-0 me-2">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button hx-post="/Candidato/Delete/@item.Id?eleccionId=@ViewBag.IdEleccion"
                                    hx-target="#candidatos-area-@ViewBag.IdEleccion"
                                    hx-swap="innerHTML"
                                        hx-confirm="¿Eliminar a @item.Nombre?"
                                    hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'
                                        class="btn btn-link btn-sm text-danger p-0">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>