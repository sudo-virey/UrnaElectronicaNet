@model UrnaElectronica.Models.Eleccion
@{ Layout = null; }

<div id="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 9999;">
    <div style="background: white; padding: 1.5rem; border-radius: 12px; width: 450px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
        <h3 style="margin-top: 0; color: #333; font-size: 1.25rem;">Nueva Elección</h3>
        <p class="text-muted small">Agregue un nuevo nivel de votación a este proceso.</p>
        <hr />

        <form hx-post="/Eleccion/Create" hx-target="#modal-container">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdProceso" />

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 5px;">Nombre de la Elección:</label>
                <input type="text" name="Nombre" class="form-control" placeholder="Ej. Alcaldía, Diputación..." required maxlength="100">
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div style="text-align: right; padding-top: 1rem; display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" onclick="document.getElementById('modal-backdrop').remove()" 
                        class="btn btn-outline-secondary" style="border-radius: 8px;">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-primary" style="border-radius: 8px; padding-left: 20px; padding-right: 20px;">
                    Guardar Elección
                </button>
            </div>
        </form>
    </div>
</div>