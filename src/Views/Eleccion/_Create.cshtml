@model UrnaElectronica.Models.Eleccion
@{
    Layout = null;
}

<div id="modal-backdrop" class="app-modal-backdrop">
    <div class="app-modal app-modal--sm">
        <h3 class="app-modal__title">Nueva Elección</h3>
        <p class="app-modal__subtitle">Agregue un nuevo nivel de votación a este proceso.</p>
        <hr />

        <form hx-post="/Eleccion/Create" hx-target="#modal-container">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdProceso" />
            <div class="app-modal__field">
                <label>Nombre de la Elección:</label>
                <input type="text" name="Nombre" class="form-control" placeholder="Ej. Alcaldía, Diputación..." required
                       maxlength="100">
            </div>


            <div class="app-modal__footer">
                <button type="button" onclick="document.getElementById('modal-backdrop').remove()"
                        class="btn-cancel-modal">Cancelar</button>
                <button type="submit" class="btn-save-modal">Guardar</button>
            </div>
        </form>
    </div>
</div>